# SSIL CMS Backend Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/ssil_cms

# JWT Authentication Secret
JWT_SECRET=ssil_secure_jwt_secret_key_2026_production_safe
JWT_EXPIRES_IN=7d

# Initial Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed CORS Origins (comma separated)
CLIENT_URL=http://localhost:3000
